rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Matches belong to the referee who scored them.
    match /matches/{matchId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      // New matches must be created for yourself, and an update cannot hand a match to someone else.
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Tournaments: the host manages them; public ones can be read by any signed-in user.
    match /tournaments/{tournamentId} {
      allow read: if signedIn() && (resource.data.type == 'public' || resource.data.hostId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == request.auth.uid;
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      // Players register themselves; the host can manage everyone.
      match /players/{playerId} {
        function isHost() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostId == request.auth.uid;
        }
        allow read: if signedIn();
        allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isHost());
        allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isHost());
      }
    }

    // Profiles: anyone signed in can read (needed to show names in tournaments),
    // only the owner can write.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
